# =============================================================================
# Twenty CRM — Railway + Supabase Environment Variables
# =============================================================================
# Copy these to Railway's environment variables dashboard.
# Generate secrets with: openssl rand -base64 32
#
# NOTE: REACT_APP_SERVER_BASE_URL is a Docker BUILD arg, not a runtime env var.
# It gets baked into the frontend at build time. Set it in Railway's
# "Build" settings → Build Args, NOT in environment variables.
# Use your actual Railway domain (e.g., https://twenty.up.railway.app).
# =============================================================================

# --- Core (REQUIRED — both server and worker) ---
PG_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?sslmode=require
APP_SECRET=
SERVER_URL=https://twenty.up.railway.app
FRONTEND_URL=https://twenty.up.railway.app
REDIS_URL=redis://redis:6379
NODE_PORT=3000

# --- Storage ---
# Use "local" for quick start (files lost on redeploy). Use "s3" for production.
STORAGE_TYPE=local
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_NAME=your-bucket-name
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# --- Auth (set even if not using Google — required by validation) ---
AUTH_GOOGLE_APIS_CALLBACK_URL=https://twenty.up.railway.app/auth/google/callback
# AUTH_GOOGLE_ENABLED=false
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GOOGLE_CALLBACK_URL=https://twenty.up.railway.app/auth/google/callback

# --- Email ---
EMAIL_DRIVER=logger
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=noreply@yourdomain.com
# EMAIL_FROM_NAME=YourApp

# --- Security ---
SIGN_IN_PREFILLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true
IS_MULTIWORKSPACE_ENABLED=false

# --- Server-only overrides (set ONLY on the worker service) ---
# DISABLE_DB_MIGRATIONS=true
# DISABLE_CRON_JOBS_REGISTRATION=true
